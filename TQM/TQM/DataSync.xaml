<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TQM.DataSync" BackgroundColor="white" 
             xmlns:effects="clr-namespace:TQM.Effects" NavigationPage.HasBackButton="False">
    <NavigationPage.TitleView>
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Source="SasthaLogo.jpg" Aspect="AspectFit" HeightRequest="40" WidthRequest="40"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Sri Sastha" FontSize="30" TextColor="#0e0273" VerticalTextAlignment="Center" />
                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Grid.ColumnSpan="2" HorizontalOptions="End" Text="Start Backup" 
                        x:Name="backupButton" Clicked="backupButton_Clicked"  BackgroundColor="#0e0273" TextColor="white" CornerRadius="25"/>
            </Grid>
        </StackLayout>
    </NavigationPage.TitleView>
    <StackLayout>
        <!--<Entry x:Name="entry_backupProgress" HorizontalTextAlignment="Center"
               FontSize="Large"
               BackgroundColor="Green" Margin="100,200,900,0">
            <Entry.Effects>
                <effects:PlainEntry/>
            </Entry.Effects>
        </Entry>-->

        <Image x:Name="img_notification" IsVisible="False" HorizontalOptions="Center"
                       Source="loading.gif" IsAnimationPlaying="True" 
                       Aspect="AspectFit" HeightRequest="120" WidthRequest="120"/>

        <Label x:Name="lbl_backupProgress" HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               TextColor="White"
               FontSize="Large" HeightRequest="50"
               BackgroundColor="Green" Margin="100,50,900,0">
        </Label>
    </StackLayout>
</ContentPage>