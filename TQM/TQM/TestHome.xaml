<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TQM.TestHome" xmlns:effects="clr-namespace:TQM.Effects" 
             BackgroundColor="white" NavigationPage.HasBackButton="False">
    <NavigationPage.TitleView>
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Source="SasthaLogo.jpg" Aspect="AspectFit" HeightRequest="40" WidthRequest="40"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Sri Sastha" FontSize="30" TextColor="#0e0273" VerticalTextAlignment="Center" />
            </Grid>
        </StackLayout>
    </NavigationPage.TitleView>
    <ContentPage.Content>
        <StackLayout>
            <Grid Margin="20,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Text="Machine Category"  
                       FontSize="16" TextColor="#0e0273" Margin="0,10"/>
                <Picker Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="picker_machinecategory" HorizontalTextAlignment="Center"
                        Margin="0,0,90,0" 
                        SelectedIndexChanged="picker_machinecategory_SelectedIndexChanged" TextColor="Green" FontSize="16">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String></x:String>
                            <x:String>OE Auto Coner</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
                
                <Label Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Text="Machine Name"
                       Margin="45,10,0,0"
                       FontSize="16" TextColor="#0e0273"/>
                <Picker Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" ItemDisplayBinding="{Binding machineName}" 
                        SelectedIndexChanged="picker_machinename_SelectedIndexChanged" Margin="15,0,90,0"
                    x:Name="picker_machinename" TextColor="Green" FontSize="16" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text = "Section-1" Margin="0,50,0,0"
                        x:Name="btn_section1" 
                        BackgroundColor="#0e0273" TextColor="White" CornerRadius="5" />

                <Button Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Text = "Section-2" Margin="0,50,0,0"
                        x:Name="btn_section2" 
                        BackgroundColor="#0e0273" TextColor="White" CornerRadius="5" />

                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text = "Section-3" Margin="0,50,0,0"
                        x:Name="btn_section3" 
                        BackgroundColor="#0e0273" TextColor="White" CornerRadius="5" />

                <Button Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Text = "Section-4" Margin="0,50,0,0"
                        x:Name="btn_section4" 
                        BackgroundColor="#0e0273" TextColor="White" CornerRadius="5" />

            </Grid>
         </StackLayout>
    </ContentPage.Content>
</ContentPage>

