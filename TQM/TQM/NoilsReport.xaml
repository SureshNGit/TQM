<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:TQM"
             x:Class="TQM.NoilsReport" NavigationPage.HasBackButton="False">

    <ContentPage.Resources>
        <local:AllTrueMultiConverter x:Key="AllTrueConverter" />
        <local:TextFormatterBaedOnMacCat x:Key="MacCategoryTestValueConverter" />
        <local:TextFormatterStandardValue x:Key="MacCategoryStdConverter" />
    </ContentPage.Resources>


    <NavigationPage.TitleView>
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Source="SasthaLogo.jpg" Aspect="AspectFit" HeightRequest="40" WidthRequest="40"/>
                <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="Sri Sastha" FontSize="30" TextColor="#0e0273" VerticalTextAlignment="Center" />
                <Image Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" x:Name="img_notification" IsVisible="False" HorizontalOptions="Center"
                       Source="loading.gif" IsAnimationPlaying="True" 
                       Aspect="AspectFit" HeightRequest="40" WidthRequest="40"/>
                <Label Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="3" Text="Noils Report" x:Name="lbl_reportHeader" 
                       Margin="0,0,0,0" HorizontalOptions="Start" FontSize="18" TextColor="Red" VerticalTextAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="1" HorizontalOptions="End" Text="Back" 
                        x:Name="btn_backToReport"  Clicked="btn_backToReport_Clicked" BackgroundColor="green" TextColor="white" CornerRadius="25"/>
                <Button Grid.Row="0" Grid.Column="7" Grid.ColumnSpan="2" HorizontalOptions="End" Text="Send Report" 
                        x:Name="btn_saveToPDF"  Clicked="btn_saveToPDF_Clicked" BackgroundColor="#0e0273" TextColor="white" CornerRadius="25"/>
            </Grid>
        </StackLayout>
    </NavigationPage.TitleView>

    <ContentPage.Content>


        <StackLayout Margin="10,10,10,10">

