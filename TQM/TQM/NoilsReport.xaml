                                               Text="{Binding machineName}" FontSize="14"/>
                                    <Label Grid.Column="4" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                               Text="{Binding shift}" FontSize="14"/>
                                    
                                    
                                    <Label Grid.Column="5" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                               Text="{Binding standardValue}" FontSize="14"/>

                                    <!--< Test Nminus1 >-->

                                    <Label Grid.Column="6" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                            Text="{Binding noilsAvgWeight,StringFormat='{0:N2}'}" 
                                        FontSize="14">

                                        <Label.IsVisible>
                                            <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                <Binding Path="isWhite" />
                                                <!--<Binding Path="isSpinning" />-->
                                             </MultiBinding>
                                        </Label.IsVisible>

                                    </Label>

                                     <Label Grid.Column="6" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                               Text="{Binding noilsAvgWeight,StringFormat='{0:N2}'}" 
                                           FontSize="14" BackgroundColor="Red" TextColor="White">

                                        <Label.IsVisible>
                                            <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                <Binding Path="isRed" />
                                                <!--<Binding Path="isSpinning" />-->
                                            </MultiBinding>
                                        </Label.IsVisible>

                                    </Label>

                                   

                                    <!--< End of Test Nminus1 >-->

                                   
                                    
                                    <!--< Standard Deviation >-->


                                    <Label Grid.Column="7" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           Text="{Binding standardDeviation,StringFormat='{0:N2}'}" FontSize="14"/>

                                    <!--< End of Standard Deviation >-->


                                    <!--< Co-Efficient of Variation >-->

                                    <Label Grid.Column="8" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
