<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TQM.homePage" NavigationPage.HasNavigationBar="false">

    <NavigationPage.TitleView>
        <StackLayout Orientation="Horizontal" HorizontalOptions="EndAndExpand" VerticalOptions="Center" >
            <Image Source="SasthaLogo.jpg" Aspect="AspectFit" HeightRequest="40" WidthRequest="40">

            </Image>
            <Label Text="Sri Satha" FontSize="16" TextColor="White" VerticalTextAlignment="Center" />
        </StackLayout>
    </NavigationPage.TitleView>

    <StackLayout>
            <Label Text="Welcome to Textile Quality Management Utility!!!" Margin="0,10"
                VerticalOptions="Start" 
                HorizontalOptions="CenterAndExpand" />
            <Button x:Name="yarnCount" 
               Text="Yarn Count" 
               Margin="10"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               Style="{StaticResource normalButton}"
               Clicked="yarnCount_Clicked"/>
    </StackLayout>

</ContentPage>