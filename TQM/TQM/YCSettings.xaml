                       <StackLayout>
                            <Grid Margin="20,-20,0,-30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--<Label Grid.Row="1" Grid.Column="0" x:Name="lbl_stdRollingStrength_Sec1" Text="Std. Rolling Strength"
                                HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

                                <Entry Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text = "" x:Name="entry_stdRollingStrength_Sec1" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="140,0,90,0"
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="1" Grid.Column="2" x:Name="lbl_strengthDeviation_Sec1" Text="Strength Deviation (±)"
                                HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="-95,10,0,0"/>

                                <Entry Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="1" Text = "" x:Name="entry_strengthDeviation_Sec1" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="50,0,60,0"
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="1" Grid.Column="3" x:Name="lbl_belowLimit_Sec1" Text="Min Limit"
                                HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="-60,10,0,0"/>

                                <Entry Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="1" Text = "" x:Name="entry_belowLimit_Sec1" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="20,0,90,0"
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="1" Grid.Column="4" x:Name="lbl_maxRollingCount_Sec1" Text="Max Limit"
                                HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="-100,10,0,0"/>

                                 <Entry Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_maxRollingCount_Sec1" 
