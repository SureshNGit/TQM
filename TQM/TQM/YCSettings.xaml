<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TQM.YCSettings" BackgroundColor="White" NavigationPage.HasBackButton="False">

    <NavigationPage.TitleView>
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Source="SasthaLogo.jpg" Aspect="AspectFit" HeightRequest="40" WidthRequest="40"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Sri Sastha" FontSize="30" TextColor="#0e0273" VerticalTextAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="1" Text="Save" x:Name="btn_save" Clicked="btn_save_Clicked"
                        BackgroundColor="#0e0273" TextColor="White" CornerRadius="25"/>
            </Grid>
        </StackLayout>
    </NavigationPage.TitleView>

    <ContentPage.Content>
        <StackLayout>
            <Grid Margin="200,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Text="Test System" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Picker Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" x:Name="picker_countsysname" TextColor="Green" FontSize="16"
                        VerticalTextAlignment="Center" HorizontalTextAlignment="Center">   
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Nec</x:String>
                            <x:String>Nm</x:String>
                            <x:String>Den</x:String>
                            <x:String>Tex</x:String>
                        </x:Array>
                    </Picker.ItemsSource>       
                </Picker>
                <Label Grid.Row="1" Grid.Column="0" Text="Sample Length Unit" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Picker Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" x:Name="picker_yarnlengthunit" TextColor="Green" FontSize="16"
                        VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Yard</x:String>
                            <x:String>Meter</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
                <Label Grid.Row="2" Grid.Column="0" Text="Sliver Length" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_sliverlength" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                <Label Grid.Row="3" Grid.Column="0" Text="Roving Length" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_rovinglength" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                <Label Grid.Row="4" Grid.Column="0" Text="Test Sample (Wrapping)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_testcount" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                
                <Label Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Text="Standard Hank (Wrapping)" HorizontalOptions="Start" TextColor="Red" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_standardHank" Keyboard="Numeric" TextColor="red" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                
                <Label Grid.Row="5" Grid.Column="0" Text="Test Sample (A%)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_testcountApercent" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <!--<Label Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Text="Standard Hank (A%)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_standardHank_Apercent" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>-->

                <Label Grid.Row="6" Grid.Column="0" Text="Test Sample (Stretch)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_testcountStretch" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <!--<Label Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" Text="Standard Hank (Stretch)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_standardHank_Stretch" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>-->

                <Label Grid.Row="7" Grid.Column="0" Text="Test Sample (Noils)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_testcountNoils" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <!--<Label Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="2" Text="Standard Hank (Noils)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="7" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_standardHank_Noils" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>-->

            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>