                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />-->

                                <Label Grid.Row="1" Grid.Column="0" x:Name="lbl_Drums_from_s1" Text="Drum Numbers from"
                                HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

                                <Entry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Text = "1" x:Name="entry_Drums_from_s1" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="0,0,80,0"
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="1" Grid.Column="2" x:Name="lbl_Drums_to_s1" Text="to"
                                HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="-80,10,0,0"/>

                                <Entry Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="1" Text = "24" x:Name="entry_Drums_to_s1" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="-60,0,140,0" 
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                 <!--<Label Grid.Row="2" Grid.Column="2" Text="Drum Selection" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="-80,10,0,0"/>
                                <Picker Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="1" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"
                                   IsEnabled="False" x:Name="picker_drumSection_Sec1" TextColor="Green" FontSize="16" Margin="30,0,60,0">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String></x:String>
                                            <x:String>Random</x:String>
                                            <x:String>Scheduled</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>

                                <Label Grid.Row="2" Grid.Column="3" Text="Period" IsVisible="true"
                                HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="-50,10,0,0"/>

                                <DatePicker Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="1" MinimumDate="01/06/2022"
                                HorizontalOptions="Center" Margin="-90,0,0,0" FontSize="18" IsVisible="true"
                                DateSelected="date_scheduledStartDate_Sec1_DateSelected"
                                Unfocused="date_scheduledStartDate_Sec1_Unfocused"
                                x:Name="date_scheduledStartDate_Sec1" TextColor="green"/>

                                <DatePicker Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" MinimumDate="01/06/2022"
                                HorizontalOptions="Start" Margin="105,0,0,0" FontSize="18" IsVisible="true"
                                            DateSelected="date_scheduledEndDate_Sec1_DateSelected"
                                            Unfocused="date_scheduledEndDate_Sec1_Unfocused"
                                x:Name="date_scheduledEndDate_Sec1" TextColor="green"/>

                                <Entry Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="1" Text = "1" x:Name="entry_scheduledDayLimit_Sec1" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="20,0,120,0" IsVisible="false" IsEnabled="False"
