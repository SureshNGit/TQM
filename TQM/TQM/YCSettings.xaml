                                <Label Grid.Row="3" Grid.Column="0" x:Name="lbl_totalTestCount_Sec1" Text="No. of Test"
                                HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

