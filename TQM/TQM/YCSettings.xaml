                    <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="1" Text="Section-2 &#x25BC;" x:Name="btn_section2"
                            HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False"
                        BackgroundColor="#0e0273" TextColor="White" CornerRadius="5" HeightRequest="35" Clicked="btn_section2_Clicked"/>

