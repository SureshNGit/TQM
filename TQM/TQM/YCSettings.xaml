<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TQM.YCSettings" xmlns:effects="clr-namespace:TQM.Effects" BackgroundColor="White" NavigationPage.HasBackButton="False">

    <NavigationPage.TitleView>
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Source="SasthaLogo.jpg" Aspect="AspectFit" HeightRequest="40" WidthRequest="40"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Sri Sastha" FontSize="30" TextColor="#0e0273" VerticalTextAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="1" Text="Save" x:Name="btn_save" Clicked="btn_save_Clicked"
                        BackgroundColor="#0e0273" TextColor="White" CornerRadius="25"/>
            </Grid>
        </StackLayout>
    </NavigationPage.TitleView>

    <ContentPage.Content>
        <StackLayout>
            <Grid Margin="20,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Text="Machine Category" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Picker Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"
                    x:Name="picker_machinecategory" TextColor="Green" FontSize="16" SelectedIndexChanged="picker_machinecategory_SelectedIndexChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String></x:String>
                            <x:String>Carding</x:String>
                            <x:String>Breaker Drawing</x:String>
                            <x:String>Comber</x:String>
                            <x:String>Drawing</x:String>
                            <!--<x:String>RSB</x:String>-->
                            <x:String>Simplex/SpeedFrame</x:String>
                            <x:String>Spinning</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                    <!--<Picker.Effects>
                        <effects:PlainEntry/>
                    </Picker.Effects>-->
                </Picker>
                <Label Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Text="Machine Name" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Picker Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" ItemDisplayBinding="{Binding machineName}" SelectedIndexChanged="picker_machinename_SelectedIndexChanged" 
                    x:Name="picker_machinename" TextColor="Green" FontSize="16" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                    <!--<Picker.Effects>
                        <effects:PlainEntry/>
                    </Picker.Effects>-->
                </Picker>
                <Label Grid.Row="1" Grid.Column="0" Text="Test System" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Picker Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" x:Name="picker_countsysname" TextColor="Green" FontSize="16"
                        VerticalTextAlignment="Center" HorizontalTextAlignment="Center">   
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String></x:String>
                            <x:String>Nec</x:String>
                            <x:String>Nm</x:String>
                            <x:String>Den</x:String>
                            <x:String>Tex</x:String>
                        </x:Array>
                    </Picker.ItemsSource>       
                </Picker>
                <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="Sample Length Unit" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Picker Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="1" x:Name="picker_yarnlengthunit" TextColor="Green" FontSize="16"
                        VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String></x:String>
                            <x:String>Yard</x:String>
                            <x:String>Meter</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>


                <Label Grid.Row="2" Grid.Column="0" x:Name="lbl_lealength" Text="Lea Length" IsVisible="false"
                       HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_leaLength" 
                       Keyboard="Numeric" TextColor="Green" FontSize="16" IsVisible="false"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                <!--<Picker Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" x:Name="picker_leaLength" TextColor="Green" FontSize="16"
                        VerticalTextAlignment="Center" HorizontalTextAlignment="Center" IsVisible="false">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String></x:String>
                            <x:String>Half Lea</x:String>
                            <x:String>Full Lea</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>-->

                <Label Grid.Row="2" Grid.Column="0" x:Name="lbl_sliverlength" Text="Sliver Length" IsVisible="false"
                       HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_sliverlength" 
                       Keyboard="Numeric" TextColor="Green" FontSize="16" IsVisible="false"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                <Label Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" x:Name="lbl_rovinglength" IsVisible="false"
                       Text="Roving Length" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="1" Text = "" x:Name="entry_rovinglength"
                       Keyboard="Numeric" TextColor="Green" FontSize="16" IsVisible="false"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                
                
                <Label Grid.Row="3" Grid.Column="0" Text="Test Sample (Wrapping)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_testcount" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
                
                <Label Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="Standard Hank (Wrapping)" x:Name="lbl_standardHank"
                       HorizontalOptions="Start" TextColor="Red" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="1" Text = "" x:Name="entry_standardHank" Keyboard="Numeric" TextColor="red" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <Label Grid.Row="4" Grid.Column="0" Text="Hank Deviation %" HorizontalOptions="Start" x:Name="lbl_hankDeviation"
                       TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_hankDeviationPercent" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <Label Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="Test Sample (A%)" IsVisible="false"
                       HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" x:Name="lbl_testCountApercent" Margin="0,10,0,0"/>
                <Entry Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_testcountApercent" 
                       Keyboard="Numeric" TextColor="Green" FontSize="16" IsVisible="false"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <Label Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Text="Standard A%" IsVisible="false"
                       HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" x:Name="lbl_standardApercent" Margin="0,10,0,0"/>
                <Entry Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="1" Text = "" x:Name="entry_standardApercent" 
                       Keyboard="Numeric" TextColor="Green" FontSize="16" IsVisible="false"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <!--<Label Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Text="Standard Hank (A%)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_standardHank_Apercent" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>-->

                <Label Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="1" Text="Test Sample (Stretch)" IsVisible="false"
                       HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" x:Name="lbl_testCountStretch" Margin="0,10,0,0"/>
                <Entry Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_testcountStretch" 
                       Keyboard="Numeric" TextColor="Green" FontSize="16" IsVisible="false"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <!--<Label Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" Text="Standard Hank (Stretch)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_standardHank_Stretch" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>-->

                <Label Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="Test Sample (Noils)" IsVisible="false"
                       HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" x:Name="lbl_testCountNoils" Margin="0,10,0,0"/>
                <Entry Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_testcountNoils" 
                       Keyboard="Numeric" TextColor="Green" FontSize="16" IsVisible="false"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <Label Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Text="Standard Noils %" IsVisible="false"
                       HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" x:Name="lbl_standardNoils" Margin="0,10,0,0"/>
                <Entry Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="1" Text = "" x:Name="entry_standardNoils" 
                       Keyboard="Numeric" TextColor="Green" FontSize="16" IsVisible="false"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                <!--<Label Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="2" Text="Standard Hank (Noils)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Entry Grid.Row="7" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_standardHank_Noils" Keyboard="Numeric" TextColor="Green" FontSize="16"
                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>-->

                <Label Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="1"  Text="No.Of Shift(s)" HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                <Picker Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="1" x:Name="picker_shiftCount" TextColor="Green" FontSize="16"
                        VerticalTextAlignment="Center" HorizontalTextAlignment="Center" SelectedIndexChanged="picker_shiftCount_SelectedIndexChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String></x:String>
                            <x:String>1</x:String>
                            <x:String>2</x:String>
                            <x:String>3</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label x:Name="shift1label" Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" Text="Shift-1 Start Time (in 24hrs)" 
                       HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0" IsVisible="False" />
                <TimePicker Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="1" x:Name="Shift1_timePicker"
                    Time="11:00:00" HorizontalOptions="Center"
                    Format="HH:mm" TextColor="Green" IsVisible="False" />

                <Label  x:Name="shift2label" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="1" Text="Shift-2 Start Time (in 24hrs)" 
                        HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0" IsVisible="False" />
                <TimePicker Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="1" x:Name="Shift2_timePicker"
                    Time="11:00:00" HorizontalOptions="Center"
                    Format="HH:mm" TextColor="Green" IsVisible="False" />

                <Label  x:Name="shift3label" Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="2" Text="Shift-3 Start Time (in 24hrs)" 
                        HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0" IsVisible="False" />
                <TimePicker Grid.Row="7" Grid.Column="3" Grid.ColumnSpan="1" x:Name="Shift3_timePicker"
                    Time="11:00:00" HorizontalOptions="Center"
                    Format="HH:mm" TextColor="Green" IsVisible="False" />

            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>