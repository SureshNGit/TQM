<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TQM.YCSettings" xmlns:effects="clr-namespace:TQM.Effects" BackgroundColor="White" NavigationPage.HasBackButton="False">

    <NavigationPage.TitleView>
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Source="SasthaLogo.jpg" Aspect="AspectFit" HeightRequest="40" WidthRequest="40"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Sri Sastha" FontSize="30" TextColor="#0e0273" VerticalTextAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" Text="+" x:Name="btn_addUserField" Clicked="btn_addUserField_Clicked"
                        BackgroundColor="Red" TextColor="White" Margin="80,2,60,0" />
                <Button Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="1" Text="Save" x:Name="btn_save" Clicked="btn_save_Clicked"
                        BackgroundColor="#0e0273" TextColor="White" CornerRadius="25"/>
            </Grid>
        </StackLayout>
    </NavigationPage.TitleView>

    <ContentPage.Content>
        <ScrollView>
            <StackLayout>
                <Grid Margin="20,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Frame Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" HorizontalOptions="Start" IsVisible="true"
                        BackgroundColor="LightGoldenrodYellow" BorderColor="White" CornerRadius="0" HasShadow="False" x:Name="frame_general">
                       <StackLayout>
                            <Grid Margin="5,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Text="Category" 
                                       TextColor="#0e0273" FontSize="16" Margin="0,10,0,0" IsVisible="true" />
                                <Picker Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"
                                    IsVisible="true" Margin="-80,0,0,0" IsEnabled="True"
                                    x:Name="picker_machinecategory" TextColor="Green" FontSize="16" SelectedIndexChanged="picker_machinecategory_SelectedIndexChanged">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String></x:String>
                                            <x:String>OE Auto Coner</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>

                                <Label Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" Text="Name" TextColor="#0e0273" FontSize="16"
                                       Margin="0,10,0,0"/>
                                <Picker Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="1" ItemDisplayBinding="{Binding machineName}"
                                        SelectedIndexChanged="picker_machinename_SelectedIndexChanged" Margin="-140,0,0,0"
                                    x:Name="picker_machinename" TextColor="Green" FontSize="16" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                                </Picker>

                                <Label Grid.Row="1" Grid.Column="0" x:Name="lbl_macSpeed" Text="Machine Speed"
                                       TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                                <Entry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_macSpeed" 
                                       Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="-40,0,0,0"
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="1" Grid.Column="2" x:Name="lbl_p1" Text="P1"
                                       TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                                <Entry Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="1" Text = "" x:Name="entry_p1" 
                                       Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="20,0,0,0"
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="1" Grid.Column="3" x:Name="lbl_p1Deviation" Text="P1 Deviation (±)"
                                       TextColor="red" FontSize="16" Margin="0,10,0,0"/>
                                <Entry Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_p1Deviation" 
                                       Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="-30,0,50,0"
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="2" Grid.Column="2" x:Name="lbl_p2" Text="P2"
                                       TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                                <Entry Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="1" Text = "" x:Name="entry_p2" 
                                       Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="20,0,0,0"
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="2" Grid.Column="3" x:Name="lbl_p2Deviation" Text="P2 Deviation (±)"
                                       TextColor="red" FontSize="16" Margin="0,10,0,0"/>
                                <Entry Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_p2Deviation" 
                                       Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="-30,0,50,0"
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="3" Grid.Column="2" x:Name="lbl_n1" Text="N1"
                                       TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                                <Entry Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="1" Text = "" x:Name="entry_n1" 
                                       Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="20,0,0,0"
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="3" Grid.Column="3" x:Name="lbl_n1Deviation" Text="N1 Deviation (±)"
                                       TextColor="red" FontSize="16" Margin="0,10,0,0"/>
                                <Entry Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="1" Text = "" x:Name="entry_n1Deviation" 
                                       Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="-30,0,50,0"
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="4" Grid.Column="0" x:Name="lbl_drumCount" Text="Total Drum Count"
                                       TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>
                                <Entry Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="1" Text = "" x:Name="entry_drumCount" Margin="-30,0,0,0"
                                       Keyboard="Numeric" TextColor="Green" FontSize="16" TextChanged="entry_drumCount_TextChanged"
                                       VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="1" Text="No. Of Sections"
                                       TextColor="#0e0273" FontSize="16"
                                       Margin="0,10,0,0"/>
                                <Picker Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="1" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"
                                        Margin="-40,0,80,0"
                                    x:Name="picker_sectionCount" TextColor="Green" FontSize="16" SelectedIndexChanged="picker_sectionCount_SelectedIndexChanged">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String></x:String>
                                            <x:String>1</x:String>
                                            <x:String>2</x:String>
                                            <x:String>3</x:String>
                                            <x:String>4</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>

                                <Label Grid.Row="5" Grid.Column="0" x:Name="lbl_stdRollingStrength" Text="Std. Rolling Strength"
                                TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

                                <Entry Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text = "" x:Name="entry_stdRollingStrength" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="140,0,0,0"
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="5" Grid.Column="2" x:Name="lbl_strengthDeviation" Text="Deviation (±)"
                                TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

                                <Entry Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="1" Text = "" x:Name="entry_strengthDeviation" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="-40,0,80,0"
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>

                                <Label Grid.Row="6" Grid.Column="0" x:Name="lbl_MinLimit" Text="Minimum Limit"
                                TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

                                <Entry Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Text = "" x:Name="entry_MinLimit" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="140,0,0,0"
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="6" Grid.Column="2" x:Name="lbl_MaxLimit" Text="Max Limit"
                                TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

                                 <Entry Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="1" Text = "" x:Name="entry_MaxLimit" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="-35,0,80,0"
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />


                                <Label Grid.Row="7" Grid.Column="0" x:Name="lbl_totalTestCount" Text="Number of Test"
                                TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

                                <Entry Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Text = "" x:Name="entry_totalTestCount" 
                                Keyboard="Numeric" TextColor="Green" FontSize="16" Margin="140,0,0,0"
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="7" Grid.Column="2" x:Name="lbl_matCount" Text="Material Count"
                                TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

                                <Entry Grid.Row="7" Grid.Column="3" Grid.ColumnSpan="1" Text = "" x:Name="entry_matCount" 
                                Keyboard="Text" TextColor="Green" FontSize="16" Margin="-35,0,80,0"
                                VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />

                                <Label Grid.Row="8" Grid.Column="0" Text="Scheduled Period Start" IsVisible="true"
                                HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

                                <DatePicker Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="1" MinimumDate="01/06/2022"
                                HorizontalOptions="Center" Margin="0,0,0,0" FontSize="18" IsVisible="true"
                                x:Name="date_scheduledStartDate" TextColor="green"/>

                                <Label Grid.Row="8" Grid.Column="2" Text="End" IsVisible="true"
                                HorizontalOptions="Start" TextColor="#0e0273" FontSize="16" Margin="0,10,0,0"/>

                                <DatePicker Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2" MinimumDate="01/06/2022"
                                HorizontalOptions="Start" Margin="60,0,0,0" FontSize="18" IsVisible="true"
                                x:Name="date_scheduledEndDate" TextColor="green"/>
                            </Grid>
                       </StackLayout>
                    </Frame>

                    <!--Section -1 -->
                    
                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="1" Text="Section-1 &#x25BC;" x:Name="btn_section1"
