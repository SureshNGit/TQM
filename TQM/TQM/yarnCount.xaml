        <StackLayout Orientation="Horizontal"
             HorizontalOptions="FillAndExpand"
                     Margin="10,50">
            <Button Style="{StaticResource successButton}"
                        x:Name="testYCButton"
                        Text="Start Test"
                    CornerRadius="25"
                    Margin="10"
                    Clicked="testYCButton_Clicked"
                        HorizontalOptions="Start"/>
