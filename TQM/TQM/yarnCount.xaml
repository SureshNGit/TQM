                        Text="View Result"
                    CornerRadius="25"
                        Margin="10"
                        HorizontalOptions="EndAndExpand"/>
            </StackLayout>
        </StackLayout>

        <StackLayout>
            <StackLayout>
                <Label x:Name="lbl_output" Text="Output......"
