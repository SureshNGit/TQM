    <StackLayout>
        <Label Text="Yarn Count Calulator"
                HorizontalOptions="Center"
               Margin="0,30"
                FontSize="25"
               TextColor="{StaticResource blueColor}"/>
        
        <StackLayout>
            <Frame Grid.RowSpan="3" Grid.ColumnSpan="2" BackgroundColor="LightGray">
                <Label x:Name="lbl_error" VerticalOptions="Center" HorizontalOptions="Center" Text="" TextColor="red" FontSize="Medium"/>
            </Frame>
        </StackLayout>

        <Entry x:Name="entry_yardcount" 
               Text="6"
                   ClearButtonVisibility="WhileEditing"
                    Keyboard="Numeric"
                   Margin="40,25,40,15"/>

        <Entry x:Name="entry_testcount" 
               Text="1"
                   ClearButtonVisibility="WhileEditing"
                    Keyboard="Numeric"
                   Margin="40,25,40,15"/>

        <StackLayout Orientation="Horizontal"
             HorizontalOptions="FillAndExpand"
                     Margin="10,50">
            <Button Style="{StaticResource successButton}"
                        x:Name="testYCButton"
                        Text="Start Test"
                    CornerRadius="25"
                    Margin="10"
                    Clicked="testYCButton_Clicked"
                        HorizontalOptions="Start"/>
            <StackLayout Orientation="Horizontal"
                 HorizontalOptions="FillAndExpand">
                <Button Style="{StaticResource warningButton}"
                        x:Name="displayResultYCButton"
                        Text="View Result"
                    CornerRadius="25"
                        Margin="10"
                        HorizontalOptions="EndAndExpand"/>
            </StackLayout>
        </StackLayout>

        <StackLayout>
                <Label x:Name="lbl_output" Text=""
                HorizontalOptions="Center"
               Margin="0,30"
                FontSize="25"
               TextColor="{StaticResource blueColor}"/>
        </StackLayout>

    </StackLayout>

</ContentPage>