                                       Text="{Binding count}" FontSize="16"/>
                                    <Label Grid.Column="3" Grid.Row="0" 
                                       Text="{Binding strength}" FontSize="16"/>
                                    <Label Grid.Column="4" Grid.Row="0" 
                                       Text="{Binding CSP}" FontSize="16"/>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Frame>

