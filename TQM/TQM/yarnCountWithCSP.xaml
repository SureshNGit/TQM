        </StackLayout>

        <Entry x:Name="entry_yardcount" 
               Text="6"
                   ClearButtonVisibility="WhileEditing"
                    Keyboard="Numeric"
                   Margin="40,25,40,15"/>

        <Entry x:Name="entry_testcount" 
               Text="2"
                   ClearButtonVisibility="WhileEditing"
                    Keyboard="Numeric"
                   Margin="40,25,40,15"/>

        <StackLayout Orientation="Horizontal"
             HorizontalOptions="FillAndExpand"
                     Margin="10,50">
