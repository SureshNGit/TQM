<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TQM.yarnCountWithCSP" BackgroundColor="white" 
             xmlns:effects="clr-namespace:TQM.Effects" NavigationPage.HasBackButton="False">
    
    <NavigationPage.TitleView>
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Source="SasthaLogo.jpg" Aspect="AspectFit" HeightRequest="40" WidthRequest="40"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Sri Sastha" FontSize="30" TextColor="#0e0273" VerticalTextAlignment="Center" />
                <Label Grid.Row="0" Grid.Column="2" Text="CSP" FontSize="25" TextColor="White" 
                       VerticalTextAlignment="Center" HorizontalOptions="Start" BackgroundColor="green" />
                <Label Grid.Row="0" Grid.Column="3" Text="Test ID :" FontSize="16" TextColor="#0e0273" 
                       VerticalTextAlignment="Center" HorizontalOptions="Start" />
                <Label Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Text="" FontSize="16" TextColor="ForestGreen" Margin="65,0"
                       VerticalTextAlignment="Center" HorizontalOptions="Start" x:Name="lbl_TestID" />
                <ActivityIndicator x:Name="act_id" IsVisible="False" IsRunning="False"
                                   Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="End"/>
                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" Grid.ColumnSpan="2" HorizontalOptions="End" Text="Start" 
                        x:Name="testYCButton"  Clicked="testYCButton_Clicked" BackgroundColor="#0e0273" TextColor="white" CornerRadius="25"/>
            </Grid>
        </StackLayout>
    </NavigationPage.TitleView>


