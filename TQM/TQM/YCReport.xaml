<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TQM.YCReport">
    <NavigationPage.TitleView>
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Source="SasthaLogo.jpg" Aspect="AspectFit" HeightRequest="40" WidthRequest="40"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Sri Sastha" FontSize="30" TextColor="#0e0273" VerticalTextAlignment="Center" />
                <!--<Entry Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="1" HorizontalOptions="Start" x:Name="entry_reportNo"/>-->
                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="2" HorizontalOptions="End" Text="Save To PDF" 
                        x:Name="btn_saveToPDF"  Clicked="btn_saveToPDF_Clicked" BackgroundColor="#0e0273" TextColor="white" CornerRadius="25"/>
            </Grid>
        </StackLayout>
    </NavigationPage.TitleView>

    <ContentPage.Content>


        <StackLayout Margin="10,10,10,10">

            <ListView x:Name="listview_tcreport"   IsGroupingEnabled="true" 
                      HasUnevenRows="True"
                       Margin="5,0,10,10" IsVisible="true" VerticalScrollBarVisibility="Always" HorizontalScrollBarVisibility="Always">
                <ListView.GroupHeaderTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout Margin="0,20,0,0">
                                 <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="1"
                                    Text="Test ID" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" HorizontalTextAlignment="Start" Margin="60,0,0,0"
                                    Text="{Binding testID}" FontSize="14" TextColor="Green"/>
                                    <Label Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="1"
                                    Text="Tester" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="1" HorizontalTextAlignment="Start" Margin="50,0,0,0"
                                    Text="{Binding userName}" FontSize="14" TextColor="Green"/>
                                    <Label Grid.Column="3" Grid.Row="0" Grid.ColumnSpan="1"
                                    Text="Machine Category" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="3" Grid.Row="0"  Grid.ColumnSpan="2" HorizontalTextAlignment="Start" Margin="120,0,0,0"
                                    Text="{Binding machineCategory}" FontSize="14" TextColor="Green"/>
                                    <Label Grid.Column="4" Grid.Row="0" Grid.ColumnSpan="1" HorizontalTextAlignment="End"
                                    Text="Machine Name" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="4" Grid.Row="0"  Grid.ColumnSpan="2" HorizontalTextAlignment="Center" Margin="100,0,0,0"
                                    Text="{Binding machineName}" FontSize="14" TextColor="Green"/>

                                    <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="1"
                                    Text="Count System" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" HorizontalTextAlignment="Start" Margin="100,0,0,0"
                                    Text="{Binding countsysname}" FontSize="14" TextColor="Green"/>
                                    <Label Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="1"
                                    Text="Length Unit" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="1" HorizontalTextAlignment="Start" Margin="80,0,0,0"
                                    Text="{Binding yarnlenunit}" FontSize="14" TextColor="Green"/>
                                    <Label Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="1"
                                    Text="Length" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="3" Grid.Row="1"  Grid.ColumnSpan="1" HorizontalTextAlignment="Start" Margin="50,0,0,0"
                                    Text="{Binding yarnlength}" FontSize="14" TextColor="Green"/>
                                    <Label Grid.Column="4" Grid.Row="1" Grid.ColumnSpan="1" HorizontalTextAlignment="Center" Margin="50,0,0,0"
                                    Text="Total Test" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="4" Grid.Row="1"  Grid.ColumnSpan="2" HorizontalTextAlignment="Center" 
                                    Text="{Binding totaltestcount}" FontSize="14" TextColor="Green"/>

                                    <Label Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="1"
                                    Text="Average" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" HorizontalTextAlignment="Start" Margin="60,0,0,0"
                                    Text="{Binding testaverage}" FontSize="14" TextColor="Green"/>
                                    <Label Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="1"
                                    Text="SD" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="1" HorizontalTextAlignment="Start" Margin="30,0,0,0"
                                    Text="{Binding testsd}" FontSize="14" TextColor="Green"/>
                                    <Label Grid.Column="3" Grid.Row="2" Grid.ColumnSpan="1"
                                    Text="CV" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="3" Grid.Row="2"  Grid.ColumnSpan="1" HorizontalTextAlignment="Start" Margin="30,0,0,0"
                                    Text="{Binding testcv}" FontSize="14" TextColor="Green"/>
                                    <Label Grid.Column="4" Grid.Row="2" Grid.ColumnSpan="1" HorizontalTextAlignment="Center" Margin="15,0,0,0"
                                    Text="A%" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="4" Grid.Row="2" Grid.ColumnSpan="2" HorizontalTextAlignment="Center" Margin="25,0,0,0"
                                    Text="{Binding apercent}" FontSize="14" TextColor="Green"/>

                                    <Label Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="1" 
                                    Text="Date" FontSize="14" TextColor="#0e0273"/>
                                    <Label Grid.Column="0" Grid.Row="3"  Grid.ColumnSpan="2" HorizontalTextAlignment="Start" Margin="60,0,0,0"
                                    Text="{Binding createdate}" FontSize="14" TextColor="Green"/>
                                </Grid>
                      

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="#0e0273" HeightRequest="1" VerticalOptions="Start" HorizontalOptions="FillAndExpand"/>
                                    <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="#0e0273" HeightRequest="1" VerticalOptions="End" HorizontalOptions="FillAndExpand"/>


                                    <BoxView Grid.Column="0" Grid.Row="0" Grid.RowSpan="1" BackgroundColor="#0e0273" WidthRequest="1" VerticalOptions="FillAndExpand" HorizontalOptions="Start"/>
                                    <BoxView Grid.Column="1" Grid.Row="0" Grid.RowSpan="1" BackgroundColor="#0e0273" WidthRequest="1" VerticalOptions="FillAndExpand" HorizontalOptions="Start"/>
                                    <BoxView Grid.Column="2" Grid.Row="0" Grid.RowSpan="1" BackgroundColor="#0e0273" WidthRequest="1" VerticalOptions="FillAndExpand" HorizontalOptions="Start"/>
                                    <BoxView Grid.Column="2" Grid.Row="0" Grid.RowSpan="1" BackgroundColor="#0e0273" WidthRequest="1" VerticalOptions="FillAndExpand" HorizontalOptions="End"/>
                                    
                                    <Label  Grid.Column="0" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                            Text="Test No"  TextColor="#0e0273" FontSize="14"/>
                                    <Label  Grid.Column="1" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                            Text="Yarn Weigth"  TextColor="#0e0273" FontSize="14"/>
                                    <Label  Grid.Column="2" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                            Text="Yarn Count" TextColor="#0e0273" FontSize="14"/>


                                </Grid>

                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.GroupHeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        
                        <ViewCell>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                 </Grid.ColumnDefinitions>


                                <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="#0e0273" HeightRequest="1" VerticalOptions="End" HorizontalOptions="FillAndExpand"/>

                                <BoxView Grid.Column="0" Grid.Row="0" Grid.RowSpan="1" BackgroundColor="#0e0273" WidthRequest="1" VerticalOptions="FillAndExpand" HorizontalOptions="Start"/>
                                <BoxView Grid.Column="1" Grid.Row="0" Grid.RowSpan="1" BackgroundColor="#0e0273" WidthRequest="1" VerticalOptions="FillAndExpand" HorizontalOptions="Start"/>
                                <BoxView Grid.Column="2" Grid.Row="0" Grid.RowSpan="1" BackgroundColor="#0e0273" WidthRequest="1" VerticalOptions="FillAndExpand" HorizontalOptions="Start"/>
                                <BoxView Grid.Column="2" Grid.Row="0" Grid.RowSpan="1" BackgroundColor="#0e0273" WidthRequest="1" VerticalOptions="FillAndExpand" HorizontalOptions="End"/>
                                
                                <Label Grid.Column="0" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                       Text="{Binding testcount}" FontSize="14"/>
                                <Label Grid.Column="1" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                       Text="{Binding yarnweight}" FontSize="14"/>
                                <Label Grid.Column="2" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                       Text="{Binding yccalcval}" FontSize="14"/>
                                
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
            
            
            
        </StackLayout>




    </ContentPage.Content>
</ContentPage>