<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TQM.UserPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" x:Name="btn_save" Clicked="btn_save_Clicked"/>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <StackLayout>
            <Grid Margin="35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Entry Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Placeholder="Enter name to search" x:Name="entry_usersearch" />
                <Button Grid.Row="0" Grid.Column="3" Text = "Search" x:Name="btn_usersearch" Clicked="btn_usersearch_Clicked"/>
            </Grid>
            <Grid Margin="35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Text="Company Name:" />
                <Picker Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" ItemDisplayBinding="{Binding Name}" x:Name="picker_companyname"/>
                <Label Grid.Row="1" Grid.Column="0" Text="First Name:" />
                <Entry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text = "" x:Name="entry_firstname"/>
                <Label Grid.Row="2" Grid.Column="0" Text="Last Name: " />
                <Entry Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="" x:Name="entry_lastname"/>
                <Label Grid.Row="3" Grid.Column="0" Text="User Id: " />
                <Entry Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="" x:Name="entry_userid"/>
                <Label Grid.Row="4" Grid.Column="0" Text="Password: " />
                <Entry Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" IsPassword="True" Text="" x:Name="entry_password"/>
                <Label Grid.Row="5" Grid.Column="0" Text="Admin: " />
                <Switch Grid.Row="5" IsToggled="False" Grid.Column="1" x:Name="switch_admin"/>
                <Label Grid.Row="5" Grid.Column="2" Text="Active: " />
                <Switch Grid.Row="5" IsToggled="False" Grid.Column="3" x:Name="switch_active"/>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>