<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TQM.UserPage" NavigationPage.HasBackButton="False">
    
    


    <NavigationPage.TitleView>
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Source="SasthaLogo.jpg" Aspect="AspectFit" HeightRequest="40" WidthRequest="40"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Sri Sastha" FontSize="30" TextColor="#0e0273" VerticalTextAlignment="Center" />
            </Grid>
        </StackLayout>
    </NavigationPage.TitleView>

    <ContentPage.Content>
        <ScrollView>
        <StackLayout>
            
            <Grid Margin="35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                <Entry Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Placeholder="Enter name to search" 
                       x:Name="entry_usersearch" FontSize="25" TextColor="Green" />
                <Button Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="1" Text = "Search" 
                        x:Name="btn_usersearch" Clicked="btn_usersearch_Clicked" 
                        BackgroundColor="#0e0273" TextColor="White" CornerRadius="25" />
            </Grid>
            <Grid Margin="35,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Text="Company Name" FontSize="20" TextColor="#0e0273" Margin="0,15" />
                <Picker Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5" ItemDisplayBinding="{Binding Name}" 
                    x:Name="picker_companyname" TextColor="Green" FontSize="20"/>
                <Label Grid.Row="1" Grid.Column="0" Text="First Name" FontSize="20" TextColor="#0e0273" Margin="0,15"/>
                <Entry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text = "" x:Name="entry_firstname" TextColor="Green" FontSize="20"/>
                <Label Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="1" Text="Last Name" FontSize="20" TextColor="#0e0273" Margin="0,15"/>
                <Entry Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Text="" x:Name="entry_lastname" TextColor="Green" FontSize="20"/>

                <Label Grid.Row="3" Grid.Column="0" Text="User Id" FontSize="20" TextColor="#0e0273" Margin="0,15"/>
                <Entry Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="" x:Name="entry_userid" TextColor="Green" FontSize="20"/>
                <Label Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="1" Text="Password" FontSize="20" TextColor="#0e0273" Margin="0,15"/>
                <Entry Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" IsPassword="True" Text="" x:Name="entry_password" TextColor="Green" FontSize="20"/>
                <Label Grid.Row="5" Grid.Column="0" Text="Admin" FontSize="20" TextColor="#0e0273" Margin="0,15"/>
                <Switch Grid.Row="5" Grid.Column="1" IsToggled="False"  x:Name="switch_admin" HorizontalOptions="Start" Margin="0,15"/>
                <Label Grid.Row="5" Grid.Column="3" Text="Active" FontSize="20" TextColor="#0e0273" Margin="0,15"/>
                <Switch Grid.Row="5" Grid.Column="4" IsToggled="False" x:Name="switch_active" HorizontalOptions="Start" />
                <Button Grid.Row="5" Grid.Column="5" Grid.ColumnSpan="1" Text="Save" 
                        x:Name="btn_save" Clicked="btn_save_Clicked"  BackgroundColor="#0e0273" TextColor="white" CornerRadius="25"/>
                </Grid>
        </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>